# ==============================================================================
# PETTY CASH SYSTEM - ENVIRONMENT CONFIGURATION
# ==============================================================================

PORT=5000

# ------------------------------------------------------------------------------
# SUPABASE CONFIGURATION (POSTGRESQL + AUTH + STORAGE)
# Found in: Supabase Dashboard -> Project Settings -> API
# ------------------------------------------------------------------------------
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ------------------------------------------------------------------------------
# ZOHO BOOKS OAUTH 2.0 CREDENTIALS
# Generated in: Zoho Developer Console (https://api-console.zoho.com)
# Client Type: Server-based Application
# Authorized Redirect URI: http://localhost:5000/api/zoho/callback
# ------------------------------------------------------------------------------
ZOHO_CLIENT_ID=1000.EXAMPLECLIENTID12345
ZOHO_CLIENT_SECRET=example_client_secret_67890
ZOHO_REDIRECT_URI=http://localhost:5000/api/zoho/callback
ZOHO_ORG_ID=789123456
ZOHO_DC=com

# AUTO SYNC INTERVAL (in minutes)
SYNC_INTERVAL_MINUTES=15
